{
  "name": "agent-core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The shared agent core of pi-do and X Gardener: browser executor, memory, conversation runtime, Pi session and journal, chat UI",
  "exports": {
    "./browser": {
      "types": "./src/browser/index.d.ts",
      "default": "./src/browser/index.js"
    },
    "./browser/code-sandbox.html": "./src/browser/code-sandbox.html",
    "./browser-tool": {
      "types": "./src/browser-tool/index.d.ts",
      "default": "./src/browser-tool/index.js"
    },
    "./guidance": {
      "types": "./src/guidance/index.d.ts",
      "default": "./src/guidance/index.js"
    },
    "./memory": {
      "types": "./src/memory/index.d.ts",
      "default": "./src/memory/index.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.d.ts",
      "default": "./src/runtime/index.js"
    },
    "./pi": {
      "types": "./src/pi/index.d.ts",
      "default": "./src/pi/index.js"
    },
    "./routine": {
      "types": "./src/routine/index.d.ts",
      "default": "./src/routine/index.js"
    },
    "./ui": {
      "types": "./src/ui/index.d.ts",
      "default": "./src/ui/index.jsx"
    },
    "./ui/routines": {
      "types": "./src/ui/routines.d.ts",
      "default": "./src/ui/routines.js"
    },
    "./ui/page": {
      "types": "./src/ui/page.d.ts",
      "default": "./src/ui/page.js"
    },
    "./ui/chat.css": "./src/ui/chat.css",
    "./ui/panel.css": "./src/ui/panel.css",
    "./ui/routines.css": "./src/ui/routines.css",
    "./web": {
      "types": "./src/web/index.d.ts",
      "default": "./src/web/index.js"
    },
    "./code-sandbox-build": {
      "types": "./tools/code-sandbox-build.d.ts",
      "default": "./tools/code-sandbox-build.js"
    },
    "./worker-bundle": {
      "types": "./tools/worker-bundle.d.ts",
      "default": "./tools/worker-bundle.js"
    },
    "./worker-stubs": "./tools/worker-stubs.js",
    "./test-code-loader": {
      "types": "./tools/test-code-loader.d.ts",
      "default": "./tools/test-code-loader.js"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "typebox": "1.3.7",
    "marked": "^17.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.13"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "test": "node --import ./tools/worker-stubs.js --test \"test/**/*.test.js\""
  }
}
